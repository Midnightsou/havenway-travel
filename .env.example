# Supabase (required for admin API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin API token (Bearer token for /api/admin routes)
ADMIN_TOKEN=Admin123

# Server
PORT=5000
# Optional token used by the scheduled Supabase keep-alive workflow
SUPABASE_KEEPALIVE_TOKEN=generate_a_long_random_secret

# Bitcoin
BTC_RECEIVING_ADDRESS=your_btc_address